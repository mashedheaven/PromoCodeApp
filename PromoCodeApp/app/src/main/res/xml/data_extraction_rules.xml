<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The session is encrypted with a device-bound key, so it
     would be useless elsewhere and is left out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
